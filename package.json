{
  "name": "web-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  },
  "license": "MIT"
}
